{
  "name": "@stanzaapi/udi-decoder",
  "version": "1.0.0",
  "description": "Official zero-dependency, high-speed JavaScript/TypeScript client for FDA & EU MDR Medical Device UDI Decoder",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "keywords": [
    "fda-udi",
    "eu-mdr",
    "medical-device",
    "gs1-datamatrix",
    "hibcc",
    "iccbba",
    "gudid",
    "eudamed",
    "udi-validation"
  ],
  "author": "Stanza",
  "license": "MIT",
  "homepage": "https://stanzaapi.com/tools/udi-decoder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanzaAPI/udi-decoder-typescript.git"
  }
}